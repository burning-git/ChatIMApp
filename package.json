{
  "name": "echo-desktop",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "package:mac": "node scripts/package-mac.mjs",
    "package:win": "tauri build --verbose --target x86_64-pc-windows-msvc --bundles nsis,msi -- --locked && npm run collect:installers -- x86_64-pc-windows-msvc",
    "collect:installers": "node scripts/collect-installers.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "typescript": "~5.7.3",
    "vite": "^6.0.11"
  }
}
