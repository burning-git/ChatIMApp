{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "回声 Echo",
  "version": "0.1.9",
  "identifier": "com.echo.chatdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "回声 · AI 对话工作台",
        "width": 1380,
        "height": 900,
        "minWidth": 900,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#f5f6fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost http: https: data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "shortDescription": "A local-first AI chat workspace"
  }
}
